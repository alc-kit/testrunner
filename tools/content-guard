#!/usr/bin/env python3
"""Keep this public repository generic: refuse private addresses and denylisted names.

Scans every tracked file (or the paths given). Generic patterns are built in; the
names to keep out come from $CONTENT_DENYLIST (one regex per line) — in CI a
repository secret, so the list of names is not itself published.
Exit 0 clean, 1 findings, 2 usage.
"""
import os
import re
import subprocess
import sys

GENERIC = {
    "private IPv4 address": r"\b(?:10\.\d{1,3}|192\.168|172\.(?:1[6-9]|2\d|3[01]))\.\d{1,3}\.\d{1,3}\b",
    "internal host name": r"\b[\w-]+\.(?:internal|intranet|corp|lan)\b",
}


def main(argv):
    paths = argv or subprocess.run(["git", "ls-files"], capture_output=True, text=True,
                                   check=True).stdout.split()
    patterns = {k: re.compile(v) for k, v in GENERIC.items()}
    for n, line in enumerate(os.environ.get("CONTENT_DENYLIST", "").splitlines(), 1):
        if line.strip():
            patterns[f"denylist entry {n}"] = re.compile(line.strip(), re.I)
    found = 0
    for path in paths:
        if path == "tools/content-guard":
            continue
        try:
            text = open(path, encoding="utf-8", errors="replace").read()
        except (IsADirectoryError, FileNotFoundError):
            continue
        for lineno, line in enumerate(text.splitlines(), 1):
            for label, rx in patterns.items():
                if rx.search(line):
                    # never echo a denylisted match: the log of a public repo is public too
                    print(f"{path}:{lineno}: {label}")
                    found += 1
    print(f"content-guard: {found} finding(s) in {len(paths)} file(s)", file=sys.stderr)
    return 1 if found else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
